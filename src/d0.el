;;; d0.el -*- lexical-binding: t -*-

(require 'u0)
(require 'c0)

(defconst neuro-disasm-reg16 ["AX" "CX" "DX" "BX" "SP" "BP" "SI" "DI"])
(defconst neuro-disasm-reg8  ["AL" "CL" "DL" "BL" "AH" "CH" "DH" "BH"])
(defconst neuro-disasm-seg    ["ES" "CS" "SS" "DS"])
(defconst neuro-disasm-seg-prefix-names
  '((#x26 . "ES") (#x2E . "CS") (#x36 . "SS") (#x3E . "DS")))

(defun neuro-disasm-reg16-name (r) (aref neuro-disasm-reg16 (logand r 7)))
(defun neuro-disasm-reg8-name  (r) (aref neuro-disasm-reg8  (logand r 7)))

(defun neuro-disasm-modrm-str (modrm is-word &optional seg-prefix disp)
  "Return (reg-str . rm-str) for modrm byte. DISP already consumed."
  (let* ((mod (logand (ash modrm -6) 3))
         (reg (logand (ash modrm -3) 7))
         (rm  (logand modrm 7))
         (reg-str (if is-word (neuro-disasm-reg16-name reg) (neuro-disasm-reg8-name reg)))
         (default-seg (pcase rm (2 "SS") (3 "SS") (6 (if (> mod 0) "SS" "DS")) (_ "DS")))
         (seg-str (or seg-prefix default-seg))
         (rm-str
          (if (= mod 3)
              (if is-word (neuro-disasm-reg16-name rm) (neuro-disasm-reg8-name rm))
            (let ((base (pcase rm
                          (0 "BX+SI") (1 "BX+DI") (2 "BP+SI") (3 "BP+DI")
                          (4 "SI")    (5 "DI")
                          (6 (if (= mod 0) (format "%04Xh" (or disp 0)) "BP"))
                          (_ "BX"))))
              (pcase mod
                (0 (if (= rm 6)
                       (format "[%s]" base)
                     (format "%s:[%s]" seg-str base)))
                (1 (format "%s:[%s+%02Xh]" seg-str base (logand (or disp 0) #xFF)))
                (2 (format "%s:[%s+%04Xh]" seg-str base (logand (or disp 0) #xFFFF)))
                (_ base))))))
    (cons reg-str rm-str)))

(defun neuro-disasm--modrm-extra (mem pos modrm)
  "Return (extra-bytes . disp) consumed after modrm byte at POS."
  (let ((mod (logand (ash modrm -6) 3))
        (rm  (logand modrm 7)))
    (cond
     ((= mod 3) (cons 0 nil))
     ((and (= mod 0) (= rm 6))
      (let ((disp (logior (aref mem pos) (ash (aref mem (1+ pos)) 8))))
        (cons 2 disp)))
     ((= mod 1)
      (cons 1 (neuro-sbyte (aref mem pos))))
     ((= mod 2)
      (cons 2 (logior (aref mem pos) (ash (aref mem (1+ pos)) 8))))
     (t (cons 0 nil)))))

(defun neuro-disasm-one (mem addr)
  (let* ((op   (aref mem addr))
         (next (1+ addr)))
    (pcase op
      (#x00 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm nil)))
              (list 2 (format "ADD  %s, %s" (cdr p) (car p)))))
      (#x01 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "ADD  %s, %s" (cdr p) (car p)))))
      (#x03 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "ADD  %s, %s" (car p) (cdr p)))))
      (#x05 (let ((imm (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "ADD  AX, %04Xh" imm))))
      (#x0B (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "OR   %s, %s" (car p) (cdr p)))))
      (#x21 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "AND  %s, %s" (cdr p) (car p)))))
      (#x23 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "AND  %s, %s" (car p) (cdr p)))))
      (#x25 (let ((imm (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "AND  AX, %04Xh" imm))))
      (#x29 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "SUB  %s, %s" (cdr p) (car p)))))
      (#x2B (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "SUB  %s, %s" (car p) (cdr p)))))
      (#x2D (let ((imm (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "SUB  AX, %04Xh" imm))))
      (#x31 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "XOR  %s, %s" (cdr p) (car p)))))
      (#x33 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "XOR  %s, %s" (car p) (cdr p)))))
      (#x35 (let ((imm (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "XOR  AX, %04Xh" imm))))
      (#x39 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "CMP  %s, %s" (cdr p) (car p)))))
      (#x3B (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "CMP  %s, %s" (car p) (cdr p)))))
      (#x3D (let ((imm (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "CMP  AX, %04Xh" imm))))
      ((pred (lambda (x) (and (>= x #x40) (<= x #x47))))
       (list 1 (format "INC  %s" (neuro-disasm-reg16-name op))))
      ((pred (lambda (x) (and (>= x #x48) (<= x #x4F))))
       (list 1 (format "DEC  %s" (neuro-disasm-reg16-name (- op #x48)))))
      ((pred (lambda (x) (and (>= x #x50) (<= x #x57))))
       (list 1 (format "PUSH %s" (neuro-disasm-reg16-name (- op #x50)))))
      ((pred (lambda (x) (and (>= x #x58) (<= x #x5F))))
       (list 1 (format "POP  %s" (neuro-disasm-reg16-name (- op #x58)))))
      (#x60 (list 1 "PUSHA"))
      (#x61 (list 1 "POPA"))
      (#x70 (let ((d (aref mem next)))
              (list 2 (format "JO   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x71 (let ((d (aref mem next)))
              (list 2 (format "JNO  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x72 (let ((d (aref mem next)))
              (list 2 (format "JC   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x73 (let ((d (aref mem next)))
              (list 2 (format "JNC  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x74 (let ((d (aref mem next)))
              (list 2 (format "JZ   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x75 (let ((d (aref mem next)))
              (list 2 (format "JNZ  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x76 (let ((d (aref mem next)))
              (list 2 (format "JBE  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x77 (let ((d (aref mem next)))
              (list 2 (format "JA   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x78 (let ((d (aref mem next)))
              (list 2 (format "JS   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x79 (let ((d (aref mem next)))
              (list 2 (format "JNS  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x7C (let ((d (aref mem next)))
              (list 2 (format "JL   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x7D (let ((d (aref mem next)))
              (list 2 (format "JGE  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x7E (let ((d (aref mem next)))
              (list 2 (format "JLE  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x7F (let ((d (aref mem next)))
              (list 2 (format "JG   %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#x87 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "XCHG %s, %s" (car p) (cdr p)))))
      (#x89 (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "MOV  %s, %s" (cdr p) (car p)))))
      (#x8B (let* ((modrm (aref mem next))
                   (p (neuro-disasm-modrm-str modrm t)))
              (list 2 (format "MOV  %s, %s" (car p) (cdr p)))))
      (#x90 (list 1 "NOP"))
      ((pred (lambda (x) (and (>= x #x91) (<= x #x97))))
       (list 1 (format "XCHG AX, %s" (neuro-disasm-reg16-name (- op #x90)))))
      (#x98 (list 1 "CBW"))
      (#x99 (list 1 "CWD"))
      (#x9C (list 1 "PUSHF"))
      (#x9D (list 1 "POPF"))
      (#x9E (list 1 "SAHF"))
      (#x9F (list 1 "LAHF"))
      ((pred (lambda (x) (and (>= x #xB8) (<= x #xBF))))
       (let ((imm (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
         (list 3 (format "MOV  %s, %04Xh" (neuro-disasm-reg16-name (- op #xB8)) imm))))
      ((pred (lambda (x) (and (>= x #xB0) (<= x #xB7))))
       (list 2 (format "MOV  %s, %02Xh" (neuro-disasm-reg8-name (- op #xB0)) (aref mem next))))
      (#xC3 (list 1 "RET"))
      (#xCB (list 1 "RETF"))
      (#xCC (list 1 "INT  3"))
      (#xCD (list 2 (format "INT  %02Xh" (aref mem next))))
      (#xCF (list 1 "IRET"))
      (#xE2 (let ((d (aref mem next)))
              (list 2 (format "LOOP %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#xE8 (let ((rel (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "CALL %04Xh" (logand (+ next 2 (if (> rel #x7FFF) (- rel #x10000) rel)) #xFFFF)))))
      (#xE9 (let ((rel (logior (aref mem next) (ash (aref mem (+ next 1)) 8))))
              (list 3 (format "JMP  %04Xh" (logand (+ next 2 (if (> rel #x7FFF) (- rel #x10000) rel)) #xFFFF)))))
      (#xEB (let ((d (aref mem next)))
              (list 2 (format "JMP  %04Xh" (logand (+ next 1 (if (> d 127) (- d 256) d)) #xFFFF)))))
      (#xF0 (list 1 "LOCK"))
      (#xF2 (list 1 "REPNZ"))
      (#xF3 (list 1 "REP"))
      (#xF4 (list 1 "HLT"))
      (#xF5 (list 1 "CMC"))
      (#xF8 (list 1 "CLC"))
      (#xF9 (list 1 "STC"))
      (#xFA (list 1 "CLI"))
      (#xFB (list 1 "STI"))
      (#xFC (list 1 "CLD"))
      (#xFD (list 1 "STD"))
      (#xFF (let* ((modrm (aref mem next))
                   (ext (logand (ash modrm -3) 7))
                   (rm-str (neuro-disasm-reg16-name modrm)))
              (list 2 (pcase ext
                         (0 (format "INC  %s" rm-str))
                         (1 (format "DEC  %s" rm-str))
                         (2 (format "CALL %s" rm-str))
                         (4 (format "JMP  %s" rm-str))
                         (6 (format "PUSH %s" rm-str))
                         (_ (format "???  /%d %s" ext rm-str))))))
      (_ (list 1 (format "DB   %02Xh" op))))))

(defun neuro-disasm-range (mem start-addr n-insns)
  (let ((addr start-addr)
        (result nil)
        (count 0))
    (while (and (< count n-insns) (< addr 65534))
      (let* ((decoded (neuro-disasm-one mem addr))
             (size    (car decoded))
             (mnem    (cadr decoded))
             (raw     (let ((bytes ""))
                        (dotimes (i size)
                          (setq bytes (concat bytes (format "%02X " (aref mem (+ addr i))))))
                        (string-trim-right bytes))))
        (push (format "%04X:  %-14s  %s" addr raw mnem) result)
        (setq addr (+ addr size)
              count (1+ count))))
    (string-join (nreverse result) "\n")))

(provide 'd0)
